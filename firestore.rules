rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Which exco record does the signed-in person belong to? Excos can
    // exist before they have a login (a youth set as an exco and invited
    // later), so a record's ID isn't necessarily the auth uid. When an
    // exco is invited, /accounts/{uid} is written to point at their
    // record. Excos created before that existed have no accounts doc, and
    // their record ID *is* their uid, so that's the fallback. (This is
    // also why the manually-created first super_admin keeps working.)
    function myExcoId() {
      return exists(/databases/$(database)/documents/accounts/$(request.auth.uid))
        ? get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.excoId
        : request.auth.uid;
    }

    function excoDoc() {
      return get(/databases/$(database)/documents/excos/$(myExcoId()));
    }

    function isExco() {
      return isSignedIn() && excoDoc().data.active == true;
    }

    // Permissions now live per-ROLE (/rolesConfig/{role}), not per-exco —
    // editing a role on the Roles & Permissions page changes everyone who
    // holds it. super_admin is checked FIRST and short-circuits before
    // the rolesConfig get() ever runs: that matters because Firestore
    // rules deny the whole request if you call .data on a document that
    // doesn't exist, and a fresh project has no /rolesConfig docs yet.
    // Without the short-circuit, a brand-new super_admin couldn't do
    // anything (including seeding rolesConfig) until rolesConfig already
    // existed — a bootstrap deadlock. See the README for how the very
    // first super_admin gets created (manually, once, outside the app).
    function hasPermission(perm) {
      return isExco() && (
        excoDoc().data.role == 'super_admin' ||
        get(/databases/$(database)/documents/rolesConfig/$(excoDoc().data.role)).data.permissions[perm] == true
      );
    }

    // Exco directory — every exco can read the full list; editing your
    // own basic info is allowed, but not your own role, active status or
    // login link (no self-promotion, no un-retiring yourself).
    // Records are created either by setting a youth as an exco (Youths
    // page) or by adding an external admin (Excos page) — both gated to
    // canManageRoles. A record can exist without a login; `uid` is
    // filled in when they're invited. `.get('uid', null)` because older
    // records predate that field.
    match /excos/{excoId} {
      allow read: if isExco();
      allow update: if isExco() && (
        (
          myExcoId() == excoId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.active == resource.data.active &&
          request.resource.data.get('uid', null) == resource.data.get('uid', null)
        ) || hasPermission('canManageRoles')
      );
      allow create: if hasPermission('canManageRoles');
      allow delete: if false; // retire (active: false) instead of deleting
    }

    // Links a Firebase Auth login to its exco record (see myExcoId above).
    // Written once, when an exco is invited, by someone who can manage
    // excos. Each person can read only their own link.
    match /accounts/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if hasPermission('canManageRoles');
      allow update, delete: if false;
    }

    // Per-role permission sets, including custom roles added from the
    // Roles page (the doc ID is the role's slug). Readable by every exco
    // (the Roles & Permissions page is visible to all); only
    // canManageRoles can add, edit or remove them.
    match /rolesConfig/{role} {
      allow read: if isExco();
      allow write: if hasPermission('canManageRoles');
    }

    // Youth roster (no login) — dues, attendance, and contributions are
    // tracked against these records. Any active exco can add/edit a
    // youth's basic info (e.g. adding someone new while taking
    // attendance); dues themselves stay financial-secretary-only.
    match /youths/{youthId} {
      allow read: if isExco();
      allow create, update: if isExco();
      // Deleting is permanent, so it's limited to people who manage roles.
      // The app also refuses to delete anyone with dues or pledges on
      // record (mark them inactive instead).
      allow delete: if hasPermission('canManageRoles');

      match /dues/{yearMonth} {
        allow read: if isExco();
        allow write: if hasPermission('canEditFinance');
      }
    }

    // Contribution drives (e.g. Pastor's Birthday, Love Feast) — pledges
    // and redemptions per youth. Same finance-secretary-only write rule
    // as dues; readable by every exco.
    match /contributions/{contributionId} {
      allow read: if isExco();
      allow write: if hasPermission('canEditFinance');

      match /pledges/{youthId} {
        allow read: if isExco();
        allow write: if hasPermission('canEditFinance');
      }

      // Support from someone outside the youth roster (e.g. a parent).
      // Auto-generated doc IDs, so no wildcard tied to a specific person.
      match /externalSupport/{supportId} {
        allow read: if isExco();
        allow write: if hasPermission('canEditFinance');
      }
    }

    // Flat top-level collections — "finance/transactions/{txId}" style
    // nesting under a literal "finance" document is invalid Firestore
    // rules syntax (a wildcard can't follow a literal document segment
    // without a collection name in between), so these are plain
    // top-level collections instead.
    match /transactions/{txId} {
      allow read: if isExco();
      allow write: if hasPermission('canEditFinance');
    }

    // One doc per year (id = the year, e.g. "2026"): the balance carried
    // over into that year, split by cash and transfer.
    match /openingBalances/{year} {
      allow read: if isExco();
      allow write: if hasPermission('canEditFinance');
    }

    match /financeReports/{reportId} {
      allow read: if isExco();
      allow write: if hasPermission('canEditFinance');
    }

    match /meetings/{meetingId} {
      allow read: if isExco();
      allow write: if hasPermission('canEditMinutes');

      // Attendance is keyed by youthId, but marking it is still an
      // exco action, gated the same as the meeting's minutes.
      match /attendance/{youthId} {
        allow read: if isExco();
        allow write: if hasPermission('canEditMinutes');
      }
    }

    match /events/{eventId} {
      allow read: if isExco();
      allow write: if hasPermission('canEditEvents');

      match /attendance/{youthId} {
        allow read: if isExco();
        allow write: if hasPermission('canEditEvents');
      }
    }

    // Yearly planner. Any exco can SUGGEST a programme and edit or remove
    // their own while it's still just a suggestion; approving, declining,
    // editing anyone's, and creating the event from it need canEditEvents.
    // (A suggester can't approve their own: status must stay 'suggested'
    // and the event link can't be set by them.)
    match /programmes/{programmeId} {
      allow read: if isExco();
      allow create: if isExco()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'suggested'
        && !('eventId' in request.resource.data);
      allow update: if hasPermission('canEditEvents')
        || (isExco()
            && resource.data.createdBy == request.auth.uid
            && resource.data.status == 'suggested'
            && request.resource.data.status == 'suggested'
            && request.resource.data.createdBy == resource.data.createdBy
            && !('eventId' in request.resource.data));
      allow delete: if hasPermission('canEditEvents')
        || (isExco() && resource.data.createdBy == request.auth.uid && resource.data.status == 'suggested');
    }

    match /activities/{activityId} {
      allow read: if isExco();
      allow write: if isExco(); // any exco can log an activity
    }

    // Activity log is append-only from Cloud Functions; no direct client writes.
    match /activityLogs/{logId} {
      allow read: if isExco();
      allow write: if false;
    }

    match /notifications/{uid}/{notifId} {
      allow read, update: if isSignedIn() && request.auth.uid == uid;
      allow write: if false; // created by Cloud Functions
    }
  }
}
